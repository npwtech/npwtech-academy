# Copie para .env e preencha com os dados do seu projeto Supabase
# (Painel do Supabase → Project Settings → API).
# A chave "anon"/publishable é pública por natureza: a proteção do conteúdo vem do RLS.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Os segredos abaixo NÃO vão neste arquivo. Configure-os nas Edge Functions:
#   supabase secrets set MP_ACCESS_TOKEN=APP_USR-...      (Mercado Pago → Suas integrações → Credenciais de produção)
#   supabase secrets set MP_WEBHOOK_SECRET=...            (Mercado Pago → Webhooks → Assinatura secreta)
#   supabase secrets set SITE_URL=https://academy.npwtech.com.br
#   supabase secrets set ALLOWED_ORIGINS=https://academy.npwtech.com.br
